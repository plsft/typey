{
	"name": "typey",
	"version": "0.1.0",
	"description": "Tiny CLI that converts text between common identifier cases (camel, snake, kebab, pascal).",
	"type": "module",
	"bin": {
		"typey": "./dist/index.js"
	},
	"scripts": {
		"build": "bun build src/index.ts --outdir dist --target bun",
		"start": "bun run src/index.ts",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"format": "prettier --check .",
		"format:fix": "prettier --write .",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix"
	},
	"keywords": [
		"cli",
		"case",
		"text",
		"snake",
		"camel",
		"kebab",
		"pascal"
	],
	"license": "MIT",
	"author": "Plural Software",
	"engines": {
		"bun": ">=1.1.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.17.0",
		"@rehearse/ci": "^0.3.17",
		"@rehearse/cli": "^0.3.17",
		"@types/bun": "latest",
		"@types/figlet": "^1.7.0",
		"eslint": "^9.17.0",
		"globals": "^15.14.0",
		"prettier": "^3.4.2",
		"typescript": "^5.6.0",
		"typescript-eslint": "^8.18.0"
	},
	"dependencies": {
		"@types/node": "^25.6.0",
		"figlet": "^1.11.0"
	}
}
